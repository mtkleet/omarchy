#!/bin/bash
# omarchy:summary=Keep Omarchy user data outside HOME
# omarchy:hidden=true

set -Eeuo pipefail
umask 077

DATA_HOME="${OMARCHY_DATA_HOME:-$HOME/.local/omarchyshell}"
AGENT_HOME="${OMARCHY_AGENT_HOME:-$DATA_HOME/agents}"

die() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

entries=(
  "$HOME/.agents|$AGENT_HOME/.agents|private"
  "$HOME/.claude|$AGENT_HOME/.claude|private"
  "$HOME/.codex|$AGENT_HOME/.codex|private"
  "$HOME/.gemini|$AGENT_HOME/.gemini|private"
  "$HOME/.hermes|$AGENT_HOME/.hermes|private"
  "$HOME/.pi|$AGENT_HOME/.pi|private"
  "$HOME/.grok|$AGENT_HOME/.grok|private"
  "$HOME/Work|$DATA_HOME/Work|normal"
  "$HOME/Projects|$DATA_HOME/Projects|normal"
  "$HOME/Downloads|$DATA_HOME/Downloads|normal"
  "$HOME/Pictures|$DATA_HOME/Pictures|normal"
  "$HOME/Videos|$DATA_HOME/Videos|normal"
)

preflight() {
  local source="$1"
  local target="$2"

  if [[ -L "$source" ]]; then
    [[ "$(realpath -m -- "$source")" == "$(realpath -m -- "$target")" ]] ||
      die "Unexpected symlink: $source -> $(readlink -- "$source")"
    [[ -d "$target" ]] || die "Missing symlink target: $target"
  elif [[ -e "$source" ]]; then
    [[ -d "$source" ]] || die "Not a directory: $source"
    [[ ! -e "$target" && ! -L "$target" ]] ||
      die "Conflict: both $source and $target exist"
  fi

  [[ ! -L "$target" ]] || die "Target is a symlink: $target"
  [[ ! -e "$target" || -d "$target" ]] || die "Target is not a directory: $target"
}

for entry in "${entries[@]}"; do
  IFS='|' read -r source target kind <<< "$entry"
  preflight "$source" "$target"
done

mkdir -p "$DATA_HOME" "$AGENT_HOME"
chmod 700 "$DATA_HOME" "$AGENT_HOME"

for entry in "${entries[@]}"; do
  IFS='|' read -r source target kind <<< "$entry"

  if [[ -L "$source" ]]; then
    rm -- "$source"
    printf 'Removed HOME symlink: %s\n' "$source"
  elif [[ -e "$source" ]]; then
    mv -- "$source" "$target"
    printf 'Moved: %s\n' "$source"
  fi

  mkdir -p "$target"

  if [[ "$kind" == "private" ]]; then
    chmod 700 "$target"
  fi
done

printf 'Centralized data: %s\n' "$DATA_HOME"
printf 'No directories or symlinks created in HOME.\n'

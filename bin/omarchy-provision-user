#!/bin/bash

# omarchy:summary=Finalize Omarchy user setup (runtime tweaks /etc/skel can't do)
# omarchy:hidden=true

set -euo pipefail

usage() {
  cat <<USAGE
Usage: omarchy finalize user [--force] [--first-install]

Runs the per-user setup steps that /etc/skel can't seed:
centralized agent homes and GTK bookmarks,
default browser/mailto, and install/user/all.sh.

For shipped configs see /etc/skel (new users) and omarchy-reinstall-configs
(existing users explicitly resyncing).

--first-install is used by the ISO in the target chroot. It marks shipped
migrations complete for the freshly-created user.

Idempotency marker: ~/.local/state/omarchy/done/finalize-user
USAGE
}

if (( EUID == 0 )); then
  echo "Error: run omarchy-provision-user as the user being configured, not as root." >&2
  exit 1
fi

force=0
first_install=0
while (($#)); do
  case "$1" in
    --force)
      force=1
      shift
      ;;
    --first-install)
      first_install=1
      force=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

state_dir="$HOME/.local/state/omarchy"
mkdir -p "$state_dir"

if omarchy-done check finalize-user && (( force == 0 )); then
  echo "User finalization already complete."
  exit 0
fi

export OMARCHY_PATH="${OMARCHY_PATH:-/usr/share/omarchy}"
export OMARCHY_INSTALL="${OMARCHY_INSTALL:-$OMARCHY_PATH/install}"
export OMARCHY_SETUP_CONTEXT="${OMARCHY_SETUP_CONTEXT:-runtime}"
export PATH="$OMARCHY_PATH/bin:$PATH"
source "$OMARCHY_PATH/uwsm/env-hyprland.d/10-omarchy"
"$OMARCHY_PATH/bin/omarchy-centralize-user-home"

if (( first_install )) && [[ $OMARCHY_SETUP_CONTEXT == "runtime" ]]; then
  # The ISO chroot doesn't set a context; omarchy-provision-owner runs first-install
  # finalization too but with OMARCHY_SETUP_CONTEXT=provision-owner already set.
  export OMARCHY_SETUP_CONTEXT=iso-chroot
fi

if [[ -n ${OMARCHY_INSTALL_LOG_FILE:-} && -f $OMARCHY_INSTALL/helpers/logging.sh ]]; then
  source "$OMARCHY_INSTALL/helpers/logging.sh"
else
  run_logged() {
    local script="$1"
    bash -eE -c 'source "$1"' bash "$script"
  }
fi

agent_dirs=(
  "$OMARCHY_AGENTS_HOME"
  "$CLAUDE_CONFIG_DIR"
  "$CODEX_HOME"
  "$PI_CODING_AGENT_DIR"
  "$GEMINI_CLI_HOME/.gemini"
  "$HERMES_HOME"
  "$GROK_HOME"
)

for agent_dir in "${agent_dirs[@]}"; do
  mkdir -p "$agent_dir"
done

skill_roots=(
  "$OMARCHY_AGENTS_HOME/skills"
  "$CLAUDE_CONFIG_DIR/skills"
  "$CODEX_HOME/skills"
  "$PI_CODING_AGENT_DIR/skills"
  "$GEMINI_CLI_HOME/.gemini/skills"
  "$HERMES_HOME/skills"
  "$GROK_HOME/skills"
)

for skill_root in "${skill_roots[@]}"; do
  mkdir -p "$skill_root"
done

for skill in "$OMARCHY_PATH"/default/agents/skills/*/; do
  [[ -d "$skill" ]] || continue
  skill=${skill%/}
  name=${skill##*/}
  for skill_root in "${skill_roots[@]}"; do
    ln -sfn "$skill" "$skill_root/$name"
  done

  if [[ -d "$HERMES_HOME/profiles" ]]; then
    for profile in "$HERMES_HOME"/profiles/*/; do
      [[ -d "$profile" ]] || continue
      mkdir -p "$profile/skills"
      ln -sfn "$skill" "$profile/skills/$name"
    done
  fi
done

"$OMARCHY_PATH/bin/omarchy-agent-instructions" >/dev/null || true

gtk_config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/gtk-3.0"
mkdir -p "$gtk_config_dir"
# Name the rest now, so a first login in another language does not create
# translated folders beside the English ones Omarchy made and bookmarked. A
# folder the user already named, in any language, stays theirs.
for dir in Downloads Pictures Videos; do
  mkdir -p "$OMARCHY_DATA_HOME/$dir"
done
touch "$gtk_config_dir/bookmarks"
for dir in Downloads Projects Pictures Videos; do
  target="$OMARCHY_DATA_HOME/$dir"
  mkdir -p "$target"
  legacy_bookmark="file://$HOME/$dir $dir"
  bookmark="file://$target $dir"
  temp_bookmarks=$(mktemp)
  grep -vxF "$legacy_bookmark" "$gtk_config_dir/bookmarks" > "$temp_bookmarks" || true
  mv -- "$temp_bookmarks" "$gtk_config_dir/bookmarks"
  grep -qxF "$bookmark" "$gtk_config_dir/bookmarks" || printf '%s
' "$bookmark" >> "$gtk_config_dir/bookmarks"
done

source "$OMARCHY_INSTALL/user/all.sh"

omarchy-refresh-applications
env -u BROWSER XDG_CURRENT_DESKTOP= xdg-settings set default-web-browser google-chrome.desktop
xdg-mime default HEY.desktop x-scheme-handler/mailto

if (( first_install )); then
  mkdir -p "$state_dir/migrations"
  for migration in "$OMARCHY_PATH"/migrations/*.sh; do
    [[ -f $migration ]] && touch "$state_dir/migrations/$(basename "$migration")"
  done
fi

omarchy-done mark finalize-user
echo "User finalization complete."

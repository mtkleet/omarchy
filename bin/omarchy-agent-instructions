#!/bin/bash

# omarchy:summary=Manage shared agent instructions outside HOME
# omarchy:args=[--edit] [harness...]

set -euo pipefail

edit=false
if [[ ${1:-} == "--edit" ]]; then
  edit=true
  shift
fi

agent_home="${OMARCHY_AGENT_HOME:-$HOME/.local/omarchyshell/agents}"
agents_home="${OMARCHY_AGENTS_HOME:-$agent_home/.agents}"
canonical="$agents_home/AGENTS.md"
config="${XDG_CONFIG_HOME:-$HOME/.config}"

mkdir -p "$agents_home"

if [[ ! -f "$canonical" ]]; then
  printf '%s\n' "<!-- Shared Omarchy coding-agent instructions. -->" > "$canonical"
  chmod 600 "$canonical"
fi

declare -A targets=(
  [config]="$config/AGENTS.md"
  [claude]="${CLAUDE_CONFIG_DIR:-$agent_home/.claude}/CLAUDE.md"
  [codex]="${CODEX_HOME:-$agent_home/.codex}/AGENTS.md"
  [pi]="${PI_CODING_AGENT_DIR:-$agent_home/.pi/agent}/AGENTS.md"
  [gemini]="${GEMINI_CLI_HOME:-$agent_home}/.gemini/GEMINI.md"
  [hermes]="${HERMES_HOME:-$agent_home/.hermes}/AGENTS.md"
  [grok]="${GROK_HOME:-$agent_home/.grok}/AGENTS.md"
  [opencode]="${OPENCODE_CONFIG_DIR:-$config/opencode}/AGENTS.md"
)

copy_instruction() {
  local target="$1"
  local backup

  mkdir -p "$(dirname "$target")"

  if [[ -L "$target" ]]; then
    if [[ -f "$target" ]] && ! cmp -s "$target" "$canonical"; then
      backup="$target.$(date +%Y%m%d%H%M%S).bak"
      cp -L -- "$target" "$backup"
    fi
    rm -- "$target"
  elif [[ -e "$target" ]]; then
    [[ -f "$target" ]] || return 0
    cmp -s "$target" "$canonical" && return 0
    backup="$target.$(date +%Y%m%d%H%M%S).bak"
    cp -a -- "$target" "$backup"
  fi

  install -m 600 -- "$canonical" "$target"
}

if (($#)); then
  for harness in "$@"; do
    case "$harness" in
      omp|kimi|dsh)
        printf 'Skipping %s: it uses the fixed ~/.agents location.\n' "$harness" >&2
        ;;
      crush|amp)
        copy_instruction "${targets[config]}"
        ;;
      *)
        [[ -n ${targets[$harness]:-} ]] && copy_instruction "${targets[$harness]}"
        ;;
    esac
  done
else
  for harness in "${!targets[@]}"; do
    copy_instruction "${targets[$harness]}"
  done
fi

if [[ $edit == "true" ]]; then
  exec omarchy-launch-config-editor "$canonical"
fi

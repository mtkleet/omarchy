#!/bin/bash
# omarchy:summary=Print the configured home of the active Claude, Codex, or Grok account
# omarchy:hidden=true

provider="${1:-}"

case "$provider" in
  claude|codex|grok) ;;
  *)
    printf 'Usage: omarchy-agent-account-home <claude|codex|grok>\n' >&2
    exit 1
    ;;
esac

pin="OMARCHY_AGENT_${provider^^}_HOME"
registry="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/agents/accounts/$provider.json"
primary="${OMARCHY_AGENT_HOME:-$HOME/.local/omarchyshell/agents}/.$provider"
selected=""

if [[ -v $pin ]]; then
  selected="${!pin}"
elif [[ -f "$registry" ]]; then
  selected=$(omarchy-agent-account-state home "$provider")
fi

printf '%s\n' "${selected:-$primary}"
